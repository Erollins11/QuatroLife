@model RoomDetailPageViewModel
@inject IStringLocalizer<SharedResource> Localizer
@inject ILanguageRouteService Routes

@{
    var roomTitle = Localizer[Model.Room.TitleKey].Value;
    var roomDescription = Localizer[Model.Room.ShortDescriptionKey].Value;
}

<section class="page-hero compact py-5 bg-light" aria-labelledby="room-title">
    <div class="container">
        <a href="@Routes.PathFor(Model.Page.Culture, "konaklama")" class="small link-dark">@Localizer["Common.BackToList"]</a>
        <h1 id="room-title" class="mt-2">@Localizer[Model.Room.TitleKey]</h1>
        <p class="lead mb-0">@Localizer[Model.Room.ShortDescriptionKey]</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8">
                <button
                    type="button"
                    class="detail-media-trigger"
                    data-gallery-open
                    data-gallery-image="@Model.Room.Images.FirstOrDefault()"
                    data-gallery-title="@roomTitle"
                    data-gallery-description="@roomDescription"
                    aria-label="@Localizer["Gallery.Lightbox.Open", roomTitle]">
                    <img src="@Model.Room.Images.FirstOrDefault()" class="img-fluid detail-media" width="1200" height="720" alt="@roomTitle" loading="lazy" />
                    <span class="gallery-card-trigger-badge">@Localizer["Gallery.Lightbox.Badge"]</span>
                </button>
            </div>
            <div class="col-lg-4">
                <article class="liquid-card h-100">
                    <div class="liquid-body">
                        <h2 class="liquid-title display-font h5">@Localizer["Accommodation.Specs"]</h2>
                        <div class="liquid-rule"></div>
                        <ul class="list-unstyled mb-3">
                            <li><strong>@Localizer["Accommodation.Filter.Capacity"]:</strong> @Model.Room.Capacity</li>
                            <li><strong>@Localizer["Accommodation.Filter.MinSize"]:</strong> @Model.Room.SizeSqm m²</li>
                            <li><strong>@Localizer["Accommodation.Filter.Bed"]:</strong> @Localizer[$"Bed.{Model.Room.BedType}"]</li>
                            <li><strong>@Localizer["Accommodation.Filter.View"]:</strong> @Localizer[$"View.{Model.Room.ViewType}"]</li>
                        </ul>
                        <h3 class="h6">@Localizer["Accommodation.Features"]</h3>
                        <ul class="feature-list mb-4">
                            @foreach (var feature in Model.Room.FeaturesKeys)
                            {
                                <li>@Localizer[feature]</li>
                            }
                        </ul>
                        <a href="@Model.Page.BookingUrl" class="btn btn-gold w-100">@Localizer["Common.CheckAvailability"]</a>
                    </div>
                </article>
            </div>
        </div>
        @if (Model.Room.Images.Count > 1)
        {
            <div class="row g-3 mt-1">
                @for (var i = 1; i < Model.Room.Images.Count; i++)
                {
                    <div class="col-sm-6 col-lg-3">
                        <button
                            type="button"
                            class="detail-gallery-trigger"
                            data-gallery-open
                            data-gallery-image="@Model.Room.Images[i]"
                            data-gallery-title="@roomTitle"
                            data-gallery-description="@roomDescription"
                            aria-label="@Localizer["Gallery.Lightbox.Open", roomTitle]">
                            <img src="@Model.Room.Images[i]" class="img-fluid detail-gallery-thumb" width="640" height="360" alt="@roomTitle" loading="lazy" />
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</section>

<div class="gallery-lightbox" data-gallery-lightbox hidden>
    <div class="gallery-lightbox-backdrop" data-gallery-close></div>
    <div
        class="gallery-lightbox-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="gallery-lightbox-title"
        aria-describedby="gallery-lightbox-description">
        <button type="button" class="gallery-lightbox-close" data-gallery-close aria-label="@Localizer["Gallery.Lightbox.Close"]">
            <span aria-hidden="true">&times;</span>
        </button>

        <div class="gallery-lightbox-stage">
            <button type="button" class="gallery-lightbox-nav gallery-lightbox-nav-prev" data-gallery-prev aria-label="@Localizer["Gallery.Lightbox.Previous"]">
                <span aria-hidden="true">&#8249;</span>
            </button>

            <figure class="gallery-lightbox-figure mb-0">
                <img src="" alt="" class="gallery-lightbox-image" data-gallery-lightbox-image />
                <figcaption class="gallery-lightbox-caption">
                    <p class="gallery-lightbox-count" data-gallery-lightbox-count></p>
                    <h2 id="gallery-lightbox-title" class="gallery-lightbox-title"></h2>
                    <p id="gallery-lightbox-description" class="gallery-lightbox-description mb-0"></p>
                </figcaption>
            </figure>

            <button type="button" class="gallery-lightbox-nav gallery-lightbox-nav-next" data-gallery-next aria-label="@Localizer["Gallery.Lightbox.Next"]">
                <span aria-hidden="true">&#8250;</span>
            </button>
        </div>
    </div>
</div>
