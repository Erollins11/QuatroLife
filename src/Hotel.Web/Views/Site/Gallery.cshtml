@model GalleryPageViewModel
@inject IStringLocalizer<SharedResource> Localizer

<section class="page-hero compact py-5 bg-light" aria-labelledby="gallery-title">
    <div class="container">
        <h1 id="gallery-title">@Localizer["Nav.Gallery"]</h1>
        <p class="lead mb-0">@Localizer["Gallery.Intro"]</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="d-flex flex-wrap gap-2 mb-4" data-gallery-filters>
            <button type="button" class="btn btn-outline-dark btn-sm active" data-gallery-filter="all">@Localizer["Common.All"]</button>
            @foreach (var category in Model.Categories)
            {
                <button type="button" class="btn btn-outline-dark btn-sm" data-gallery-filter="@category">@Localizer[$"Gallery.Category.{category}"]</button>
            }
        </div>

        <div class="row g-3" data-gallery-grid>
            @foreach (var item in Model.Items)
            {
                var title = Localizer[item.TitleKey].Value;
                var description = Localizer[item.ShortDescriptionKey].Value;
                <div class="col-sm-6 col-lg-4" data-gallery-item data-category="@item.Category">
                    <article class="liquid-card h-100">
                        <div class="liquid-media">
                            <button
                                type="button"
                                class="gallery-card-trigger"
                                data-gallery-open
                                data-gallery-image="@item.Image"
                                data-gallery-title="@title"
                                data-gallery-description="@description"
                                aria-label="@Localizer["Gallery.Lightbox.Open", title]">
                                <img src="@item.Image" width="640" height="360" alt="@title" loading="lazy" class="card-img-top" />
                                <span class="gallery-card-trigger-badge">@Localizer["Gallery.Lightbox.Badge"]</span>
                            </button>
                        </div>
                        <div class="liquid-body">
                            <h2 class="liquid-title display-font h6">@title</h2>
                            <div class="liquid-rule"></div>
                            <p class="liquid-desc small mb-0">@description</p>
                        </div>
                    </article>
                </div>
            }
        </div>

        <div class="video-placeholder mt-5">
            <h2 class="h5">@Localizer["Gallery.Video.Title"]</h2>
            <video class="img-fluid rounded-4" width="1200" height="500" controls preload="metadata" poster="~/img/placeholders/gallery-video.svg" aria-label="@Localizer["Gallery.Video.Title"]">
                <source src="~/video/gumbet-video.mp4" type="video/mp4" />
            </video>
        </div>
    </div>
</section>

<div class="gallery-lightbox" data-gallery-lightbox hidden>
    <div class="gallery-lightbox-backdrop" data-gallery-close></div>
    <div
        class="gallery-lightbox-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="gallery-lightbox-title"
        aria-describedby="gallery-lightbox-description">
        <button type="button" class="gallery-lightbox-close" data-gallery-close aria-label="@Localizer["Gallery.Lightbox.Close"]">
            <span aria-hidden="true">&times;</span>
        </button>

        <div class="gallery-lightbox-stage">
            <button type="button" class="gallery-lightbox-nav gallery-lightbox-nav-prev" data-gallery-prev aria-label="@Localizer["Gallery.Lightbox.Previous"]">
                <span aria-hidden="true">&#8249;</span>
            </button>

            <figure class="gallery-lightbox-figure mb-0">
                <img src="" alt="" class="gallery-lightbox-image" data-gallery-lightbox-image />
                <figcaption class="gallery-lightbox-caption">
                    <p class="gallery-lightbox-count" data-gallery-lightbox-count></p>
                    <h2 id="gallery-lightbox-title" class="gallery-lightbox-title"></h2>
                    <p id="gallery-lightbox-description" class="gallery-lightbox-description mb-0"></p>
                </figcaption>
            </figure>

            <button type="button" class="gallery-lightbox-nav gallery-lightbox-nav-next" data-gallery-next aria-label="@Localizer["Gallery.Lightbox.Next"]">
                <span aria-hidden="true">&#8250;</span>
            </button>
        </div>
    </div>
</div>
